{
  "budget": {
    "heroGzipBytes": 51200,
    "frameBudgetMs": 16.67
  },
  "shaders": [
    {
      "id": "gradient",
      "note": "An animated gradient. The cheapest moving background there is, and the floor everything else is measured against.",
      "source": [
        "struct Params { time: f32, aspect: f32 }",
        "@group(0) @binding(0) var<uniform> params: Params;",
        "",
        "@fragment",
        "fn main(@location(0) uv: vec2f) -> @location(0) vec4f {",
        "  let p = vec2f(uv.x * params.aspect, uv.y);",
        "  let a = sin(p.x * 6.0 + params.time) * 0.5 + 0.5;",
        "  let b = cos(p.y * 6.0 + params.time * 0.7) * 0.5 + 0.5;",
        "  return vec4f(a * 0.4, b * 0.3, 0.6 - a * b * 0.3, 1.0);",
        "}"
      ]
    },
    {
      "id": "fbm",
      "note": "Drifting coloured noise. The kind of animated background a landing hero actually runs.",
      "source": [
        "struct Params { time: f32, aspect: f32 }",
        "@group(0) @binding(0) var<uniform> params: Params;",
        "",
        "fn hash2(p: vec2f) -> f32 {",
        "  let h = dot(p, vec2f(127.1, 311.7));",
        "  return fract(sin(h) * 43758.5453123);",
        "}",
        "fn noise2(p: vec2f) -> f32 {",
        "  let i = floor(p);",
        "  let f = fract(p);",
        "  let u = f * f * (3.0 - 2.0 * f);",
        "  let a = hash2(i);",
        "  let b = hash2(i + vec2f(1.0, 0.0));",
        "  let c = hash2(i + vec2f(0.0, 1.0));",
        "  let d = hash2(i + vec2f(1.0, 1.0));",
        "  return mix(mix(a, b, u.x), mix(c, d, u.x), u.y);",
        "}",
        "fn fbm(p: vec2f) -> f32 {",
        "  var value = 0.0;",
        "  var amplitude = 0.5;",
        "  var q = p;",
        "  for (var i = 0; i < 6; i = i + 1) {",
        "    value = value + amplitude * noise2(q);",
        "    q = q * 2.02;",
        "    amplitude = amplitude * 0.5;",
        "  }",
        "  return value;",
        "}",
        "@fragment",
        "fn main(@location(0) uv: vec2f) -> @location(0) vec4f {",
        "  let p = vec2f(uv.x * params.aspect, uv.y);",
        "  let t = params.time * 0.08;",
        "  let warp = vec2f(fbm(p * 3.0 + t), fbm(p * 3.0 + vec2f(5.2, 1.3) - t));",
        "  let n = fbm(p * 4.0 + warp * 2.0);",
        "  let tint = mix(vec3f(0.05, 0.07, 0.16), vec3f(0.42, 0.30, 0.85), n);",
        "  return vec4f(tint, 1.0);",
        "}"
      ]
    },
    {
      "id": "plasma",
      "note": "Interference bands of colour, the classic demo look. Almost as cheap as the gradient.",
      "source": [
        "struct Params { time: f32, aspect: f32 }",
        "@group(0) @binding(0) var<uniform> params: Params;",
        "",
        "@fragment",
        "fn main(@location(0) uv: vec2f) -> @location(0) vec4f {",
        "  let p = vec2f(uv.x * params.aspect, uv.y) * 6.0;",
        "  let t = params.time * 0.6;",
        "  var v = sin(p.x + t);",
        "  v = v + sin(p.y * 0.9 + t * 0.7);",
        "  v = v + sin((p.x + p.y) * 0.7 + t * 0.4);",
        "  v = v + sin(length(p - vec2f(3.0, 2.0)) * 1.2 - t);",
        "  let n = v * 0.25 * 3.14159;",
        "  let color = vec3f(0.5 + 0.5 * sin(n), 0.5 + 0.5 * sin(n + 2.09), 0.5 + 0.5 * sin(n + 4.19));",
        "  return vec4f(color * 0.75, 1.0);",
        "}"
      ]
    },
    {
      "id": "metaballs",
      "note": "Liquid blobs that merge and split as they drift. Seven of them, solved per pixel.",
      "source": [
        "struct Params { time: f32, aspect: f32 }",
        "@group(0) @binding(0) var<uniform> params: Params;",
        "",
        "@fragment",
        "fn main(@location(0) uv: vec2f) -> @location(0) vec4f {",
        "  let p = vec2f((uv.x - 0.5) * params.aspect, uv.y - 0.5);",
        "  let t = params.time * 0.35;",
        "  var field = 0.0;",
        "  for (var i = 0; i < 7; i = i + 1) {",
        "    let fi = f32(i);",
        "    let c = vec2f(sin(t * (0.6 + fi * 0.11) + fi * 2.1) * 0.42, cos(t * (0.5 + fi * 0.13) + fi * 1.7) * 0.32);",
        "    let d = p - c;",
        "    field = field + 0.02 / (dot(d, d) + 0.004);",
        "  }",
        "  let m = smoothstep(0.9, 1.9, field);",
        "  let base = vec3f(0.04, 0.05, 0.12);",
        "  let ink = mix(vec3f(0.20, 0.55, 0.95), vec3f(0.65, 0.25, 0.85), clamp(p.x + 0.5, 0.0, 1.0));",
        "  return vec4f(mix(base, ink, m), 1.0);",
        "}"
      ]
    },
    {
      "id": "aurora",
      "note": "Soft ribbons of light drifting across the page, like an aurora.",
      "source": [
        "struct Params { time: f32, aspect: f32 }",
        "@group(0) @binding(0) var<uniform> params: Params;",
        "",
        "fn hash2(p: vec2f) -> f32 {",
        "  let h = dot(p, vec2f(127.1, 311.7));",
        "  return fract(sin(h) * 43758.5453123);",
        "}",
        "fn noise2(p: vec2f) -> f32 {",
        "  let i = floor(p);",
        "  let f = fract(p);",
        "  let u = f * f * (3.0 - 2.0 * f);",
        "  let a = hash2(i);",
        "  let b = hash2(i + vec2f(1.0, 0.0));",
        "  let c = hash2(i + vec2f(0.0, 1.0));",
        "  let e = hash2(i + vec2f(1.0, 1.0));",
        "  return mix(mix(a, b, u.x), mix(c, e, u.x), u.y);",
        "}",
        "@fragment",
        "fn main(@location(0) uv: vec2f) -> @location(0) vec4f {",
        "  let p = vec2f(uv.x * params.aspect, uv.y);",
        "  let t = params.time * 0.15;",
        "  var color = vec3f(0.02, 0.03, 0.09);",
        "  for (var i = 0; i < 4; i = i + 1) {",
        "    let fi = f32(i);",
        "    let band = 0.25 + fi * 0.16;",
        "    let wobble = noise2(vec2f(p.x * 1.6 + fi * 4.0, t + fi)) - 0.5;",
        "    let d = abs(p.y - band - wobble * 0.35);",
        "    let glow = 0.035 / (d + 0.035);",
        "    let hue = mix(vec3f(0.15, 0.75, 0.55), vec3f(0.45, 0.28, 0.90), fi / 3.0);",
        "    color = color + hue * glow * 0.35;",
        "  }",
        "  return vec4f(color, 1.0);",
        "}"
      ]
    },
    {
      "id": "raymarch",
      "note": "A 3D scene traced pixel by pixel, 64 steps deep. The expensive end: where a background stops being free.",
      "source": [
        "struct Params { time: f32, aspect: f32 }",
        "@group(0) @binding(0) var<uniform> params: Params;",
        "",
        "fn sdSphere(p: vec3f, r: f32) -> f32 {",
        "  return length(p) - r;",
        "}",
        "fn map(p: vec3f, t: f32) -> f32 {",
        "  var d = 100000.0;",
        "  for (var i = 0; i < 5; i = i + 1) {",
        "    let fi = f32(i);",
        "    let c = vec3f(sin(t * 0.7 + fi * 1.9) * 1.1, cos(t * 0.6 + fi * 2.3) * 0.8, sin(t * 0.5 + fi * 1.3) * 1.1);",
        "    d = min(d, sdSphere(p - c, 0.55));",
        "  }",
        "  return d;",
        "}",
        "@fragment",
        "fn main(@location(0) uv: vec2f) -> @location(0) vec4f {",
        "  let ndc = vec2f((uv.x - 0.5) * params.aspect, uv.y - 0.5) * 2.0;",
        "  let ro = vec3f(0.0, 0.0, -4.0);",
        "  let rd = normalize(vec3f(ndc, 1.6));",
        "  let t = params.time * 0.5;",
        "  var dist = 0.0;",
        "  var hit = 0.0;",
        "  for (var i = 0; i < 64; i = i + 1) {",
        "    let p = ro + rd * dist;",
        "    let d = map(p, t);",
        "    if (d < 0.002) {",
        "      hit = 1.0;",
        "      break;",
        "    }",
        "    dist = dist + d;",
        "    if (dist > 12.0) {",
        "      break;",
        "    }",
        "  }",
        "  let glow = 1.0 - clamp(dist / 12.0, 0.0, 1.0);",
        "  let base = vec3f(0.03, 0.04, 0.10);",
        "  let ink = mix(vec3f(0.25, 0.60, 0.95), vec3f(0.70, 0.30, 0.90), glow);",
        "  return vec4f(mix(base, ink, clamp(hit * 0.9 + glow * 0.15, 0.0, 1.0)), 1.0);",
        "}"
      ]
    }
  ],
  "bundleCandidates": [
    {
      "id": "vgpu",
      "note": "vgpu 0.4.0 browser entry: init + surface + effect + frameLoop + clock.",
      "entry": [
        "import { clock, effect, frameLoop, init, surface } from 'vgpu';",
        "export async function mount(canvas) {",
        "  const gpu = await init();",
        "  const view = surface(gpu, canvas, { dpr: [1, 2] });",
        "  const pass = effect(gpu, SHADER);",
        "  const time = clock(gpu);",
        "  frameLoop(gpu, (f) => {",
        "    pass.set({ time: time.time });",
        "    f.pass(view, pass);",
        "  });",
        "}"
      ]
    },
    {
      "id": "three-webgpu",
      "note": "three 0.181 WebGPURenderer + TSL wgslFn. The apples-to-apples backend: same WGSL, same WebGPU.",
      "entry": [
        "import { Mesh, NodeMaterial, OrthographicCamera, PlaneGeometry, Scene, WebGPURenderer } from 'three/webgpu';",
        "import { wgslFn } from 'three/tsl';",
        "export async function mount(canvas) {",
        "  const renderer = new WebGPURenderer({ canvas });",
        "  await renderer.init();",
        "  const scene = new Scene();",
        "  const camera = new OrthographicCamera(-1, 1, 1, -1, 0, 1);",
        "  const material = new NodeMaterial();",
        "  material.fragmentNode = wgslFn(SHADER)();",
        "  scene.add(new Mesh(new PlaneGeometry(2, 2), material));",
        "  renderer.setAnimationLoop(() => renderer.render(scene, camera));",
        "}"
      ]
    },
    {
      "id": "three-webgl",
      "note": "three 0.181 WebGLRenderer + ShaderMaterial. The cheapest three can be, on the older backend.",
      "entry": [
        "import { Mesh, OrthographicCamera, PlaneGeometry, Scene, ShaderMaterial, WebGLRenderer } from 'three';",
        "export function mount(canvas) {",
        "  const renderer = new WebGLRenderer({ canvas });",
        "  const scene = new Scene();",
        "  const camera = new OrthographicCamera(-1, 1, 1, -1, 0, 1);",
        "  const material = new ShaderMaterial({ fragmentShader: SHADER });",
        "  scene.add(new Mesh(new PlaneGeometry(2, 2), material));",
        "  renderer.setAnimationLoop(() => renderer.render(scene, camera));",
        "}"
      ]
    }
  ],
  "render": {
    "resolutions": [
      {
        "id": "1080p dpr1",
        "width": 1920,
        "height": 1080
      },
      {
        "id": "1080p dpr2",
        "width": 3840,
        "height": 2160
      }
    ],
    "warmupFrames": 60,
    "measuredFrames": 300
  }
}
